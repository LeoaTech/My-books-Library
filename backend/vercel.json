{
    "version": 2,
    "builds": [
        {
            "src": "./index.js",
            "use": "@vercel/node"
        }
    ],
    "buildCommand": "npm run vercel-build",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.js"
        }
    ],
    "crons": [
        {
            "path": "/api/process-queue.js",
            "schedule": "* * * * *"
        }
    ]
}